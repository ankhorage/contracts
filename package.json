{
  "name": "@ankhorage/contracts",
  "version": "11.0.0",
  "main": "./dist/index.js",
  "ankh": {
    "category": "contracts",
    "provider": null,
    "capabilities": [
      "contracts.cli"
    ]
  },
  "dependencies": {
    "@ankhorage/color-theory": "^0.3.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.11.7",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.1",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./bindings": {
      "types": "./dist/bindings.d.ts",
      "default": "./dist/bindings.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./deploy": {
      "types": "./dist/deploy.d.ts",
      "default": "./dist/deploy.js"
    },
    "./runtime": {
      "types": "./dist/runtimeCallbacks.d.ts",
      "default": "./dist/runtimeCallbacks.js"
    },
    "./secrets": {
      "types": "./dist/secrets.d.ts",
      "default": "./dist/secrets.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "default": "./dist/state.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "default": "./dist/media.js"
    },
    "./navigator": {
      "types": "./dist/navigator.d.ts",
      "default": "./dist/navigator.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "default": "./dist/repository.js"
    }
  },
  "description": "Serializable app, action, theme, auth, and secret-store contracts for Ankhorage.",
  "keywords": [
    "typescript",
    "contracts",
    "schema",
    "manifest",
    "auth",
    "secrets",
    "secret-store",
    "storage",
    "adapter",
    "media",
    "navigator",
    "assets"
  ],
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/contracts.git"
  },
  "homepage": "https://github.com/ankhorage/contracts#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/contracts/issues"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
