{
  "name": "@ankhorage/contracts",
  "version": "22.8.2",
  "main": "./dist/index.js",
  "ankh": {
    "category": "contracts",
    "provider": null,
    "capabilities": [
      "contracts.cli"
    ],
    "structure": {
      "output": "src/structure/generated.ts",
      "roots": {
        "auth-flow": {
          "source": "src/auth.ts",
          "export": "AuthFlowConfig"
        },
        "auth-profile": {
          "source": "src/types.ts",
          "export": "AuthProfileSpec"
        },
        "auth-sign-in": {
          "source": "src/types.ts",
          "export": "AuthSignInSpec"
        },
        "auth-sign-up": {
          "source": "src/types.ts",
          "export": "AuthSignUpSpec"
        },
        "screen-metadata": {
          "source": "src/types.ts",
          "export": "ScreenMetadataSpec"
        },
        "screen-requirements": {
          "source": "src/requirements.ts",
          "export": "ScreenRequirements"
        },
        "theme-config": {
          "source": "src/types.ts",
          "export": "ThemeConfig"
        }
      }
    }
  },
  "dependencies": {
    "@ankhorage/color-theory": "^0.3.1",
    "@ankhorage/utility": "^1.8.1"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.19.10",
    "@ankhorage/paradox": "^0.2.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./infra": {
      "types": "./dist/infra.d.ts",
      "default": "./dist/infra.js"
    },
    "./environments": {
      "types": "./dist/environments.d.ts",
      "default": "./dist/environments.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./bindings": {
      "types": "./dist/bindings.d.ts",
      "default": "./dist/bindings.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./deploy": {
      "types": "./dist/deploy.d.ts",
      "default": "./dist/deploy.js"
    },
    "./deploy-provider": {
      "types": "./dist/deployProvider.d.ts",
      "default": "./dist/deployProvider.js"
    },
    "./runtime": {
      "types": "./dist/runtimeCallbacks.d.ts",
      "default": "./dist/runtimeCallbacks.js"
    },
    "./secrets": {
      "types": "./dist/secrets.d.ts",
      "default": "./dist/secrets.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "default": "./dist/state.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "default": "./dist/media.js"
    },
    "./navigator": {
      "types": "./dist/navigator.d.ts",
      "default": "./dist/navigator.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "default": "./dist/repository.js"
    },
    "./structure": {
      "types": "./dist/structure/index.d.ts",
      "default": "./dist/structure/index.js"
    }
  },
  "description": "Serializable app, action, theme, auth, and secret-store contracts for Ankhorage.",
  "keywords": [
    "adapter",
    "ankhorage",
    "assets",
    "auth",
    "contracts",
    "manifest",
    "media",
    "navigator",
    "schema",
    "secret-store",
    "secrets",
    "storage",
    "typescript"
  ],
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/contracts.git"
  },
  "homepage": "https://github.com/ankhorage/contracts#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/contracts/issues"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.infra-tests.json && bun run build && tsc --noEmit -p tsconfig.deploy-provider-consumer.json && bun run structure:check",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip",
    "structure:check": "ankhorage-structure check ."
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
