{
  "name": "@ankhorage/contracts",
  "version": "1.19.1",
  "main": "./dist/index.js",
  "ankh": {
    "category": "contracts",
    "provider": null,
    "capabilities": [
      "contracts.cli"
    ]
  },
  "dependencies": {
    "@ankhorage/color-theory": "^0.0.7"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.0.6",
    "@changesets/cli": "^2.30.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./bindings": {
      "types": "./dist/bindings.d.ts",
      "default": "./dist/bindings.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./nutrition": {
      "types": "./dist/nutrition/index.d.ts",
      "default": "./dist/nutrition/index.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "default": "./dist/state.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    }
  },
  "description": "Serializable app, action, and theme config contracts for Ankhorage.",
  "keywords": [
    "typescript",
    "contracts",
    "schema",
    "manifest",
    "auth",
    "storage",
    "adapter"
  ],
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/contracts.git"
  },
  "homepage": "https://github.com/ankhorage/contracts#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/contracts/issues"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "knip": "ankhorage-knip",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "test": "bun test src",
    "version-packages": "changeset version"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
